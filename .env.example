# Copy this file to `.env.local` and fill in your real values.
# Next.js loads `.env.local` automatically — it does NOT load `.env.example`.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender (use onboarding@resend.dev for testing, or your verified domain for production)
RESEND_FROM_EMAIL=Perfect Love Wedding <onboarding@resend.dev>

# WhatsApp Cloud API (Meta): https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# After RSVP, the QR pass is emailed AND WhatsApp'd when these are set.
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_or_temp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Recommended for production: approve a template in Meta Business Manager with body params
# {{1}} = guest first name, {{2}} = check-in URL. Example body:
# "Hi {{1}}, you're confirmed! Your wedding check-in pass: {{2}}"
# Without a template, Meta only allows freeform/image messages within a 24h customer-care window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# IMPORTANT:
# - Do NOT prefix secrets with NEXT_PUBLIC_ (that exposes them in the browser).
# - On Netlify, set RESEND_* and WHATSAPP_* in Site settings → Environment variables.
# - With onboarding@resend.dev, Resend only delivers to the email on your Resend account (test mode).
