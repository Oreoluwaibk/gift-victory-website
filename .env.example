# Copy this file to `.env.local` and fill in your real values.
# Next.js loads `.env.local` automatically — it does NOT load `.env.example`.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender (use onboarding@resend.dev for testing, or your verified domain for production)
RESEND_FROM_EMAIL=Perfect Love Wedding <onboarding@resend.dev>

# Your live site URL (QR codes and emails use this for check-in links).
# On Netlify, URL is set automatically — only set this if you use a custom domain:
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Supabase (server-side only — do NOT expose service role with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional public aliases if you add client-side Supabase later
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Admin dashboard (/admin)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_SESSION_SECRET=use_a_long_random_string_here

# IMPORTANT:
# - Do NOT prefix secrets with NEXT_PUBLIC_ (that exposes them in the browser).
# - On Netlify, set all secrets in Site settings → Environment variables.
# - Run supabase/schema.sql once in your Supabase SQL editor before going live.
# - With onboarding@resend.dev, Resend only delivers to the email on your Resend account (test mode).
# - WhatsApp QR sharing uses your phone's share sheet (free) — pick WhatsApp and send the image.
